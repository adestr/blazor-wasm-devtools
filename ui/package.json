{
  "name": "blazor-wasm-devtools-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:bridge && pnpm run build:panel",
    "build:panel": "vite build",
    "build:bridge": "vite build --config vite.bridge.config.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.1.24",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@12.4.1"
}
