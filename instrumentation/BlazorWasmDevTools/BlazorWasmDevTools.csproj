<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BlazorWasmDevTools</RootNamespace>
    <AssemblyName>BlazorWasmDevTools</AssemblyName>
    <PackageId>BlazorWasmDevTools</PackageId>
    <Version>0.1.0</Version>
    <Authors>Blazor WASM DevTools</Authors>
    <Description>Instrumentation package for Blazor WebAssembly apps using the Blazor WASM DevTools browser extension.</Description>
    <PackageTags>blazor;webassembly;devtools</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeBuildOutput>true</IncludeBuildOutput>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <MicrosoftPackageVersion>8.0.0</MicrosoftPackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <MicrosoftPackageVersion>9.0.0</MicrosoftPackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <MicrosoftPackageVersion>10.0.0</MicrosoftPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorWasmDevTools.Tests" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(MicrosoftPackageVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MicrosoftPackageVersion)" />
  </ItemGroup>

</Project>
