<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BlazorWasmDevTools</RootNamespace>
    <AssemblyName>BlazorWasmDevTools</AssemblyName>
    <PackageId>BlazorWasmDevTools</PackageId>
    <Version>0.1.0</Version>
    <Authors>Blazor WASM DevTools</Authors>
    <Description>Instrumentation package for Blazor WebAssembly apps using the Blazor WASM DevTools browser extension.</Description>
    <PackageTags>blazor;webassembly;devtools</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeBuildOutput>true</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorWasmDevTools.Tests" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>
